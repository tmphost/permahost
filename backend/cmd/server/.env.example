# Copy to .env and `set -a; source .env; set +a` before `go run ./cmd/server`.
PERMAHOSTIO_BASE_URL=http://localhost:5173
PERMAHOSTIO_AUTH_JWT_SECRET=change-me-to-a-long-random-string
# Required. Encrypts the settings file (AES-256-GCM). Environment only: it is
# never read from YAML. At least 32 characters, e.g. `openssl rand -hex 32`.
# Losing it means the saved settings cannot be read; re-enter them on /setup.
PERMAHOSTIO_MASTER_KEY=
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <PERMAHOSTIO_BASE_URL>/auth/google/callback
PERMAHOSTIO_AUTH_GOOGLE_CLIENT_ID=
PERMAHOSTIO_AUTH_GOOGLE_CLIENT_SECRET=
# https://github.com/settings/developers
# Authorization callback URL: <PERMAHOSTIO_BASE_URL>/auth/github/callback
PERMAHOSTIO_AUTH_GITHUB_CLIENT_ID=
PERMAHOSTIO_AUTH_GITHUB_CLIENT_SECRET=

# Unlocks /setup (generated and logged at startup when empty).
PERMAHOSTIO_AUTH_ROOT_ACCESS_TOKEN=
# Where /setup saves settings; once saved they override these env values.
# PERMAHOSTIO_SETTINGS_FILE=./_storage/settings.json
# PERMAHOSTIO_CREDITS_MONTHLY_GRANT=250

# Database: SQLite by default; set PERMAHOSTIO_POSTGRES_ENABLED=true to use PostgreSQL.
# PERMAHOSTIO_SQLITE_DSN=./_storage/permahost.db
# PERMAHOSTIO_POSTGRES_ENABLED=true
# PERMAHOSTIO_POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/permahost?sslmode=disable

# S3-compatible storage
# PERMAHOSTIO_S3_ENABLED=true
# PERMAHOSTIO_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# PERMAHOSTIO_S3_REGION=auto
# PERMAHOSTIO_S3_BUCKET=
# PERMAHOSTIO_S3_ACCESS_KEY_ID=
# PERMAHOSTIO_S3_SECRET_ACCESS_KEY=
# PERMAHOSTIO_S3_USE_PATH_STYLE=false
